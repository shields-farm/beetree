<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly advice grading on a Mac (this machine's layout, mirroring
  com.beebeetree.server). On the Pi this unit's job is done by
  deploy/beetree-advice-grader.timer instead.

  Install:
    cp deploy/com.beebeetree.grader.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.beebeetree.grader.plist
  Run once now:
    launchctl kickstart -p gui/$(id -u)/com.beebeetree.grader
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beebeetree.grader</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/markshields/beetree/scripts/run-advice-grader.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/markshields/beetree</string>

    <!-- 03:15 local, same slot as the Pi timer. Not RunAtLoad: a login should not
         fire a grading run on top of a boot. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- launchd agents get a minimal environment. tsx needs node on PATH, and the
         script needs HOME to resolve the repo and the .env beside it. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/markshields</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/markshields/beetree/server/.grader.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/markshields/beetree/server/.grader-err.log</string>
</dict>
</plist>
