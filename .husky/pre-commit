#!/usr/bin/env sh
# BeeTree pre-commit hook — typecheck + lint + tests must pass
echo "🔍 Running typecheck..."
npm run typecheck || { echo "❌ Typecheck failed — fix TypeScript errors before committing"; exit 1; }

echo "🧹 Running linter..."
npx oxlint || { echo "❌ Lint failed — fix lint errors before committing"; exit 1; }

echo "🧪 Running tests..."
npx vitest run || { echo "❌ Tests failed — fix test failures before committing"; exit 1; }

echo "✅ All checks passed"