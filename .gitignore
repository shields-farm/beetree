# Data files - too large for git
*.tar.gz
*.zip
*.wav
*.mp3
*.flac
*.ogg

# Model checkpoints
*.pt
*.pth
*.ckpt
*.safetensors
*.gguf
*.onnx

# Audio features (regenerable)
*.npy
*.npz
*.tensorgram

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Secrets
.env
*.key
*.pem

# Staging (local data, not for git)
staging/
data/audio/
data/raw/

# Capture media (filesystem store; large, regenerable, never for git)
data/media/

# launchd logs
server/*.log
server/.launchd-*.log

# Stale SQLite leftovers (the live DB is data/beetree.db)
server/beetree.db
server/beetree.db-*
server/beetree.db.*

# Playwright / e2e
e2e/.test-server-url
test-results/
playwright-report/
data/e2e.db
data/e2e.db-wal
data/e2e.db-shm
data/*.bak
