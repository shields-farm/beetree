{
  "name": "beetree",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "precommit": "npm run typecheck && npm run lint && npm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "node scripts/verify-app.mjs",
    "verify:build": "npm run build && node scripts/verify-app.mjs",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@a2ui/react": "^0.12.0",
    "@a2ui/web_core": "^0.13.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.5",
    "mermaid": "^12.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.2",
    "jsdom": "^30.0.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~7.0.0",
    "vite": "^8.1.1",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
