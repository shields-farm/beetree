# BeeTree server configuration. Copy to server/.env and adjust.
# Nothing here is required for local development.

# Shared secret for the API. If unset, one is generated on boot and printed to
# the console. Bearer tokens only — see the auth middleware in server/index.ts.
BEETREE_API_KEY=

# Set to 1 to disable bearer auth entirely. Never do this on a reachable host.
# BEETREE_DISABLE_AUTH=0

# Port for the Express API.
# PORT=3001

# --- Optional integrations -------------------------------------------------

# Home Assistant, for reading hive-adjacent sensors and switches.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=

# An OpenAI-compatible inference endpoint used by the assistant lane.
# Defaults to a local Hermes gateway on :8642 if you run one.
HERMES_API_URL=http://127.0.0.1:8642/v1/chat/completions
HERMES_API_KEY=
HERMES_MODEL=

# Separate inference server for acoustic/frame analysis, if you run one.
# BEETREE_INFER_URL=http://127.0.0.1:3002

# InfluxDB, for sensor time series (optional).
# INFLUX_URL=http://127.0.0.1:8086
# INFLUX_TOKEN=
# INFLUX_ORG=
# INFLUX_BUCKET=

# Comma-separated origins allowed to call the API from a browser. Add your own
# host here if you serve the frontend from somewhere other than localhost.
# BEETREE_ALLOWED_ORIGINS=
